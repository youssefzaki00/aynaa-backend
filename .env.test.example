# Copy to .env.test — NEVER point tests at the production database.

NODE_ENV=test
PORT=5001

MONGODB_URI=mongodb://USER:PASSWORD@HOST:PORT/aynaa_test?authSource=admin

REDIS_URL=rediss://default:PASSWORD@HOST:PORT/1
REDIS_TLS_REJECT_UNAUTHORIZED=false

API_SECRET_KEY=test-api-secret-key
ADMIN_API_KEY=test-admin-api-key
JWT_SECRET=test-jwt-secret-change-me
JWT_EXPIRE=30d

CACHE_TTL_SECONDS=300

CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_CDN_HOST=api.aynaa.org

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=aynaa-images
R2_PUBLIC_URL=
