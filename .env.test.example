# Copy this file to .env.test — NEVER point tests at the production database.
# Test suites call deleteMany({}) and will wipe collections.

NODE_ENV=test
PORT=5001

# Production database name must be "aynaa" (not aynaa-test or aynaa_test).
MONGODB_URI=mongodb://USER:PASSWORD@HOST:PORT/aynaa_test?authSource=admin

# Optional: separate Redis DB index for tests
# REDIS_URL=rediss://default:PASSWORD@HOST:PORT/1

JWT_SECRET=test-jwt-secret-change-me
API_SECRET_KEY=test-api-secret-key
